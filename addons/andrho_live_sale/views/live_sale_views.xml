<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_live_sale_list" model="ir.ui.view">
        <field name="name">andrho.live.sale.list</field>
        <field name="model">andrho.live.sale</field>
        <field name="arch" type="xml">
            <list string="Historial de lives">
                <field name="date"/>
                <field name="name"/>
                <field name="channel"/>
                <field name="item_count"/>
                <field name="sold_count"/>
                <field name="unsold_count"/>
                <field name="buyer_count"/>
                <field name="revenue" sum="Total" widget="monetary" options="{'currency_field': False}"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'live'" decoration-info="state == 'ready'"/>
            </list>
        </field>
    </record>

    <record id="view_live_sale_form" model="ir.ui.view">
        <field name="name">andrho.live.sale.form</field>
        <field name="model">andrho.live.sale</field>
        <field name="arch" type="xml">
            <form string="Venta en vivo">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,live,done"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="state not in ('ready', 'live')">
                        Sigue este orden en tu live. Si no tienes otro dispositivo para verlo, toma una captura o anótalo y síguelo: AndRho aparta y confirma por ti.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="channel"/>
                            <field name="live_url" widget="url"/>
                        </group>
                        <group>
                            <field name="sold_count"/>
                            <field name="reserved_count"/>
                            <field name="unsold_count"/>
                            <field name="revenue"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Orden de venta" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" decoration-success="state == 'confirmed'" decoration-warning="state == 'reserved'" decoration-muted="state in ('unsold', 'posted')">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image_128" widget="image" options="{'size': [40, 40]}"/>
                                    <field name="live_name"/>
                                    <field name="product_id"/>
                                    <field name="price"/>
                                    <field name="state" widget="badge"/>
                                    <field name="buyer_id"/>
                                    <field name="comment_text" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tarjetas de envío" name="cards">
                            <field name="card_ids">
                                <list>
                                    <field name="buyer_id"/>
                                    <field name="phone"/>
                                    <field name="address"/>
                                    <field name="zone"/>
                                    <field name="item_count"/>
                                    <field name="total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_live_sale_search" model="ir.ui.view">
        <field name="name">andrho.live.sale.search</field>
        <field name="model">andrho.live.sale</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="live" string="En vivo" domain="[('state', '=', 'live')]"/>
                <filter name="done" string="Terminados" domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>

    <record id="action_live_sale" model="ir.actions.act_window">
        <field name="name">Lives</field>
        <field name="res_model">andrho.live.sale</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Organiza tu primer live desde AndRho</p>
            <p>Elige tus artículos en AndRho y toca "Organizar venta": aquí aparece el orden, lo apartado y lo vendido.</p>
        </field>
    </record>
</odoo>
